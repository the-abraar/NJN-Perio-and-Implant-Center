rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDentist() {
      return request.auth != null
        && request.auth.uid == "nXfM7K8iYYaMcYgviUUO6sTdxyi1";
    }

    function isValidPatientCreate() {
      return request.resource.data.keys().hasOnly([
          "patientName",
          "patientAge",
          "patientPhone",
          "description",
          "fileURL",
          "slotStart",
          "status",
          "createdAt"
        ])
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() >= 2
        && request.resource.data.patientAge is number
        && request.resource.data.patientAge >= 1
        && request.resource.data.patientAge <= 120
        && request.resource.data.patientPhone is string
        && request.resource.data.patientPhone.size() >= 8
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && (request.resource.data.fileURL == null || request.resource.data.fileURL is string)
        && request.resource.data.slotStart is timestamp
        && request.resource.data.status == "pending"
        && request.resource.data.createdAt == request.time;
    }

    // Doc ids are slot_<slotStart millis>; online bookings only for the next 60 days.
    function isBookableSlot(slotId, slotStart) {
      return slotStart is timestamp
        && slotStart > request.time
        && slotStart < request.time + duration.value(60, "d")
        && slotId == "slot_" + string(slotStart.toMillis());
    }

    function slotStatusPath(slotId) {
      return /databases/$(database)/documents/slotStatus/$(slotId);
    }

    function appointmentPath(slotId) {
      return /databases/$(database)/documents/appointments/$(slotId);
    }

    // A patient may only take a slot that is free or was declined (cancelled).
    function isSlotFree(slotId) {
      return !exists(slotStatusPath(slotId))
        || get(slotStatusPath(slotId)).data.status == "cancelled";
    }

    // Patient booking: the appointment and its pending slotStatus must be
    // written together in one batch/transaction.
    function isPatientBooking(slotId) {
      return isValidPatientCreate()
        && isBookableSlot(slotId, request.resource.data.slotStart)
        && isSlotFree(slotId)
        && getAfter(slotStatusPath(slotId)).data.status == "pending"
        && getAfter(slotStatusPath(slotId)).data.slotStart == request.resource.data.slotStart;
    }

    function isPatientSlotStatus(slotId) {
      return isValidSlotStatusWrite()
        && request.resource.data.status == "pending"
        && isBookableSlot(slotId, request.resource.data.slotStart)
        && getAfter(appointmentPath(slotId)).data.status == "pending"
        && getAfter(appointmentPath(slotId)).data.createdAt == request.time
        && getAfter(appointmentPath(slotId)).data.slotStart == request.resource.data.slotStart;
    }

    function isValidSlotStatusWrite() {
      return request.resource.data.keys().hasOnly(["slotStart", "status"])
        && request.resource.data.slotStart is timestamp
        && request.resource.data.status in ["pending", "booked", "cancelled"];
    }

    match /appointments/{appointmentId} {
      allow read: if isDentist();
      allow create: if isPatientBooking(appointmentId);
      // Re-booking a declined slot overwrites its cancelled appointment.
      allow update: if isDentist()
        || (resource.data.status == "cancelled" && isPatientBooking(appointmentId));
      allow delete: if false;
    }

    // Public-safe mirror of appointments: exposes only slot time + status,
    // never patient name/age/phone/description/fileURL.
    match /slotStatus/{slotId} {
      allow read: if true;
      allow create: if (isDentist() && isValidSlotStatusWrite())
        || isPatientSlotStatus(slotId);
      allow update: if (isDentist() && isValidSlotStatusWrite())
        || (resource.data.status == "cancelled" && isPatientSlotStatus(slotId));
      allow delete: if false;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isDentist();
    }
  }
}
