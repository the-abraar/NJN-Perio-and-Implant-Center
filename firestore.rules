rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isDentist() {
      return request.auth != null
        && request.auth.uid == "nXfM7K8iYYaMcYgviUUO6sTdxyi1";
    }

    function isValidPatientCreate() {
      return request.resource.data.keys().hasOnly([
          "patientName",
          "patientAge",
          "patientPhone",
          "description",
          "fileURL",
          "slotStart",
          "status",
          "createdAt"
        ])
        && request.resource.data.patientName is string
        && request.resource.data.patientName.size() >= 2
        && request.resource.data.patientAge is number
        && request.resource.data.patientAge >= 1
        && request.resource.data.patientAge <= 120
        && request.resource.data.patientPhone is string
        && request.resource.data.patientPhone.size() >= 8
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 600
        && (request.resource.data.fileURL == null || request.resource.data.fileURL is string)
        && request.resource.data.slotStart is timestamp
        && request.resource.data.status == "pending";
    }

    function isValidSlotStatusWrite() {
      return request.resource.data.keys().hasOnly(["slotStart", "status"])
        && request.resource.data.slotStart is timestamp
        && request.resource.data.status in ["pending", "booked", "cancelled"];
    }

    match /appointments/{appointmentId} {
      allow read: if isDentist();
      allow create: if isValidPatientCreate()
        && !exists(/databases/$(database)/documents/appointments/$(appointmentId));
      allow update: if isDentist()
        || (resource.data.status == "cancelled" && isValidPatientCreate());
      allow delete: if false;
    }

    // Public-safe mirror of appointments: exposes only slot time + status,
    // never patient name/age/phone/description/fileURL.
    match /slotStatus/{slotId} {
      allow read: if true;
      allow create: if isValidSlotStatusWrite()
        && !exists(/databases/$(database)/documents/slotStatus/$(slotId))
        && (request.resource.data.status == "pending" || isDentist());
      allow update: if isDentist() && isValidSlotStatusWrite();
      allow delete: if false;
    }

    match /config/{docId} {
      allow read: if true;
      allow write: if isDentist();
    }
  }
}
